{
  "name": "paper-engineering-assistant",
  "version": "0.1.0",
  "description": "Local-first desktop assistant for CS paper engineering with reviewer-aligned evidence workflows.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "echo \"Add build script\"",
    "backend:dev:prisma": "pnpm --filter @paper-engineering-assistant/backend dev:prisma",
    "backend:dev:prisma:setup": "pnpm env:dev:db-url:init && pnpm env:dev:compile && pnpm db:dev:migrate",
    "ci:prisma-drift": "node ci/scripts/prisma-migrate-drift.mjs",
    "ci:prisma-smoke": "node ci/scripts/prisma-smoke.mjs",
    "db:dev:migrate": "set -a; . ./.env.local; set +a; pnpm exec prisma migrate deploy --schema prisma/schema.prisma",
    "desktop:build": "pnpm --filter @paper-engineering-assistant/desktop build",
    "desktop:dev": "pnpm --filter @paper-engineering-assistant/desktop dev",
    "desktop:typecheck": "pnpm --filter @paper-engineering-assistant/desktop typecheck",
    "dev": "echo \"Add dev script\"",
    "env:dev:compile": "python3 -B -S .ai/skills/features/environment/env-localctl/scripts/env_localctl.py compile --root . --env dev --runtime-target local --workload api --out .ai/.tmp/env-local/dev-compile.md",
    "env:dev:db-url:init": "mkdir -p env/.secrets-store/dev && if [ ! -f env/.secrets-store/dev/database_url ]; then printf 'postgresql://%s@127.0.0.1:5432/postgres?schema=my_researcher_dev\\n' \"${USER:-postgres}\" > env/.secrets-store/dev/database_url; fi && chmod 600 env/.secrets-store/dev/database_url",
    "env:dev:doctor": "python3 -B -S .ai/skills/features/environment/env-localctl/scripts/env_localctl.py doctor --root . --env dev --runtime-target local --workload api --out .ai/.tmp/env-local/dev-doctor.md",
    "experiment-foundation:full-flow": "node .ai/scripts/experiment-foundation-full-flow-runner.mjs",
    "experiment-foundation:hardening": "node .ai/scripts/experiment-foundation-hardening-runner.mjs",
    "experiment-foundation:packb:gate": "node .ai/scripts/experiment-foundation-packb-simulation-gate.mjs",
    "experiment-foundation:packb:gate:meta": "pnpm experiment-foundation:packb:scripts:typecheck && node --test .ai/scripts/lib/disposable-postgres.unit.test.mjs .ai/scripts/experiment-foundation-d19-spine-gate.unit.test.mjs .ai/scripts/experiment-foundation-packa-local-landing-gate.unit.test.mjs .ai/scripts/experiment-foundation-packb-simulation-gate.unit.test.mjs .ai/scripts/experiment-foundation-packb-local-landing-gate.unit.test.mjs .ai/scripts/experiment-foundation-packb-publish-local-evidence.unit.test.mjs && pnpm --filter @paper-engineering-assistant/backend exec node --test --loader ts-node/esm scripts/experiment-foundation-d19-disposable-database.unit.test.ts src/test-support/disposable-postgres-test-database.unit.test.ts",
    "experiment-foundation:packb:local-gate": "node --env-file=.env.local .ai/scripts/experiment-foundation-packb-local-landing-gate.mjs",
    "experiment-foundation:packb:local-app-smoke": "pnpm experiment-foundation:packb:scripts:typecheck && AUTO_PULL_SCHEDULER_ENABLED=false pnpm --filter @paper-engineering-assistant/backend exec -- node --env-file=../../.env.local --loader ts-node/esm scripts/run-experiment-foundation-packb-local-app-smoke.ts",
    "experiment-foundation:packb:scripts:typecheck": "pnpm --filter @paper-engineering-assistant/backend run typecheck:experiment-foundation-scripts",
    "experiment-foundation:packb:publish-local-evidence": "node .ai/scripts/experiment-foundation-packb-publish-local-evidence.mjs",
    "lint": "echo \"Add lint script\"",
    "paper-implementation:provider-canary": "cd apps/backend && BACKEND_TEST_PRESERVE_REAL_ENV=1 T114_TRACE_INTEGRITY_PROVIDER_CANARY_LIVE=1 T114_P1_CLAIM_BOUNDARY_PROVIDER_CANARY_LIVE=1 T114_P1_DOSSIER_READINESS_PROVIDER_CANARY_LIVE=1 T114_RESULT_ANALYSIS_PROVIDER_CANARY_LIVE=1 T114_EXPERIMENT_DESIGN_PROVIDER_CANARY_LIVE=1 T114_EXPERIMENT_CRITIQUE_PROVIDER_CANARY_LIVE=1 T114_ROUTE_ARCHITECTURE_PROVIDER_CANARY_LIVE=1 T114_ROUTE_SKEPTIC_PROVIDER_CANARY_LIVE=1 T114_VALIDATION_CYCLE_PROVIDER_CANARY_LIVE=1 T114_FEASIBILITY_PLANNING_PROVIDER_CANARY_LIVE=1 T114_CROSS_BOARD_SYNTHESIS_PROVIDER_CANARY_LIVE=1 T114_EVIDENCE_BOARD_CURATION_PROVIDER_CANARY_LIVE=1 T114_MOTIVE_DECOMPOSITION_PROVIDER_CANARY_LIVE=1 T114_MOTIVE_EVOLUTION_PROVIDER_CANARY_LIVE=1 node --env-file=../../.env.local --test --loader ts-node/esm src/routes/paper-implementation-runtime-routes.integration.test.ts",
    "paper-implementation:provider-fail-closed-canary": "cd apps/backend && BACKEND_TEST_PRESERVE_REAL_ENV=1 T114_PROVIDER_FAIL_CLOSED_CANARY_LIVE=1 node --env-file=../../.env.local --test --loader ts-node/esm src/routes/paper-implementation-runtime-routes.integration.test.ts",
    "paper-implementation:runtime-prisma-smoke": "cd apps/backend && BACKEND_TEST_PRESERVE_REAL_ENV=1 T114_RUNTIME_PRISMA_SMOKE=1 PAPER_IMPLEMENTATION_REPOSITORY=prisma AUTO_PULL_SCHEDULER_ENABLED=false node --env-file=../../.env.local --test --loader ts-node/esm src/routes/paper-implementation-runtime-routes.integration.test.ts",
    "paper-implementation:runtime-stress": "node .ai/scripts/paper-implementation-runtime-stress.mjs",
    "paper-implementation:near-prod-runtime-gate-meta": "node --test .ai/scripts/paper-implementation-near-prod-runtime-gate.meta.test.mjs",
    "paper-implementation:near-prod-runtime-gate": "node .ai/scripts/paper-implementation-near-prod-runtime-gate.mjs",
    "test": "pnpm --filter @paper-engineering-assistant/shared test && pnpm --filter @paper-engineering-assistant/backend test",
    "topic-selection:real-e2e": "node --env-file=.env.local --loader ./apps/backend/node_modules/ts-node/esm.mjs .ai/scripts/topic-selection-real-e2e.mjs",
    "topic-selection:multisample-provider-batch": "node --env-file=.env.local .ai/scripts/topic-selection-multisample-provider-batch.mjs",
    "topic-selection:v1a-harness-e2e": "node --env-file=.env.local --loader ./apps/backend/node_modules/ts-node/esm.mjs .ai/scripts/topic-selection-v1a-harness-e2e.mjs",
    "topic-selection:v1a-harness-replay-smoke": "TOPIC_SELECTION_V1A_HARNESS_REPLAY_SMOKE=1 node --env-file=.env.local --loader ./apps/backend/node_modules/ts-node/esm.mjs .ai/scripts/topic-selection-v1a-harness-e2e.mjs",
    "topic-selection:v1a-runtime-stress": "node --env-file=.env.local .ai/scripts/topic-selection-v1a-runtime-stress.mjs",
    "topic-selection:v1b-harness-e2e": "node --env-file=.env.local --loader ./apps/backend/node_modules/ts-node/esm.mjs .ai/scripts/topic-selection-v1b-harness-e2e.mjs",
    "topic-selection:v1b-runtime-stress": "node --env-file=.env.local .ai/scripts/topic-selection-v1b-runtime-stress.mjs",
    "topic-selection:v1b-near-prod-deep-test": "node --env-file=.env.local .ai/scripts/topic-selection-v1b-near-prod-deep-test.mjs",
    "topic-selection:v1b-early-semantic-runtime-smoke": "TITLE_CARD_REPOSITORY=prisma RESEARCH_LIFECYCLE_REPOSITORY=prisma TOPIC_SELECTION_V1B_HARNESS_SCENARIO=early_semantic_runtime_smoke node --env-file=.env.local --loader ./apps/backend/node_modules/ts-node/esm.mjs .ai/scripts/topic-selection-v1b-harness-e2e.mjs",
    "topic-selection:v1b-n4-runtime-smoke": "TITLE_CARD_REPOSITORY=prisma RESEARCH_LIFECYCLE_REPOSITORY=prisma TOPIC_SELECTION_V1B_HARNESS_SCENARIO=n4_runtime_smoke node --env-file=.env.local --loader ./apps/backend/node_modules/ts-node/esm.mjs .ai/scripts/topic-selection-v1b-harness-e2e.mjs",
    "topic-selection:v1b-n7-runtime-smoke": "TITLE_CARD_REPOSITORY=prisma RESEARCH_LIFECYCLE_REPOSITORY=prisma TOPIC_SELECTION_V1B_HARNESS_SCENARIO=n7_runtime_smoke node --env-file=.env.local --loader ./apps/backend/node_modules/ts-node/esm.mjs .ai/scripts/topic-selection-v1b-harness-e2e.mjs",
    "topic-selection:v1b-n6-runtime-smoke": "TITLE_CARD_REPOSITORY=prisma RESEARCH_LIFECYCLE_REPOSITORY=prisma TOPIC_SELECTION_V1B_HARNESS_SCENARIO=n6_runtime_smoke node --env-file=.env.local --loader ./apps/backend/node_modules/ts-node/esm.mjs .ai/scripts/topic-selection-v1b-harness-e2e.mjs",
    "topic-selection:v1b-n6-loopback-runtime-smoke": "TITLE_CARD_REPOSITORY=prisma RESEARCH_LIFECYCLE_REPOSITORY=prisma TOPIC_SELECTION_V1B_HARNESS_SCENARIO=n6_loopback_runtime_smoke node --env-file=.env.local --loader ./apps/backend/node_modules/ts-node/esm.mjs .ai/scripts/topic-selection-v1b-harness-e2e.mjs",
    "topic-selection:v1b-n8-runtime-smoke": "TITLE_CARD_REPOSITORY=prisma RESEARCH_LIFECYCLE_REPOSITORY=prisma TOPIC_SELECTION_V1B_HARNESS_SCENARIO=n8_runtime_smoke node --env-file=.env.local --loader ./apps/backend/node_modules/ts-node/esm.mjs .ai/scripts/topic-selection-v1b-harness-e2e.mjs",
    "topic-selection:v1c-harness-acceptance": "TS_NODE_PROJECT=apps/backend/tsconfig.json node --env-file=.env.local --loader ./apps/backend/node_modules/ts-node/esm.mjs .ai/scripts/topic-selection-v1c-harness-acceptance.mjs",
    "topic-selection:v1c-n2-runtime-smoke": "TITLE_CARD_REPOSITORY=prisma RESEARCH_LIFECYCLE_REPOSITORY=prisma TS_NODE_PROJECT=apps/backend/tsconfig.json node --env-file=.env.local --loader ./apps/backend/node_modules/ts-node/esm.mjs .ai/scripts/topic-selection-v1c-n2-runtime-smoke.mjs",
    "topic-selection:v1c-n4-runtime-smoke": "TITLE_CARD_REPOSITORY=prisma RESEARCH_LIFECYCLE_REPOSITORY=prisma TS_NODE_PROJECT=apps/backend/tsconfig.json node --env-file=.env.local --loader ./apps/backend/node_modules/ts-node/esm.mjs .ai/scripts/topic-selection-v1c-n4-runtime-smoke.mjs",
    "topic-selection:v1c-n6-runtime-smoke": "TITLE_CARD_REPOSITORY=prisma RESEARCH_LIFECYCLE_REPOSITORY=prisma TS_NODE_PROJECT=apps/backend/tsconfig.json node --env-file=.env.local --loader ./apps/backend/node_modules/ts-node/esm.mjs .ai/scripts/topic-selection-v1c-n6-runtime-smoke.mjs",
    "topic-selection:v1c-runtime-stress": "node --env-file=.env.local .ai/scripts/topic-selection-v1c-runtime-stress.mjs",
    "topic-selection:v1c-production-depth": "TS_NODE_PROJECT=apps/backend/tsconfig.json node --env-file=.env.local --loader ./apps/backend/node_modules/ts-node/esm.mjs .ai/scripts/topic-selection-v1c-production-depth.mjs",
    "topic-selection:v1c-real-codex-acceptance": "TS_NODE_PROJECT=apps/backend/tsconfig.json node --env-file=.env.local --loader ./apps/backend/node_modules/ts-node/esm.mjs .ai/scripts/topic-selection-v1c-real-codex-acceptance.mjs",
    "topic-selection:v1c-provider-canary": "cd apps/backend && BACKEND_TEST_PRESERVE_REAL_ENV=1 node --env-file=../../.env.local --test --loader ts-node/esm src/services/topic-selection-provider-canary-service.unit.test.ts",
    "topic-selection:v1b-external-codex-n4-variance": "TOPIC_SELECTION_V1B_HARNESS_SCENARIO=external_codex_n4_variance node --env-file=.env.local --loader ./apps/backend/node_modules/ts-node/esm.mjs .ai/scripts/topic-selection-v1b-harness-e2e.mjs",
    "topic-selection:v1b-external-codex-n6-variance": "TOPIC_SELECTION_V1B_HARNESS_SCENARIO=external_codex_n6_variance node --env-file=.env.local --loader ./apps/backend/node_modules/ts-node/esm.mjs .ai/scripts/topic-selection-v1b-harness-e2e.mjs",
    "topic-selection:v1b-external-codex-n8-variance": "TOPIC_SELECTION_V1B_HARNESS_SCENARIO=external_codex_n8_variance node --env-file=.env.local --loader ./apps/backend/node_modules/ts-node/esm.mjs .ai/scripts/topic-selection-v1b-harness-e2e.mjs",
    "topic-selection:v1b-provider-canary": "cd apps/backend && BACKEND_TEST_PRESERVE_REAL_ENV=1 T112_V1B_N4_PROVIDER_CANARY_LIVE=1 T112_V1B_N6_PROVIDER_CANARY_LIVE=1 T112_V1B_N8_PROVIDER_CANARY_LIVE=1 node --env-file=../../.env.local --test --loader ts-node/esm src/services/topic-selection-provider-canary-service.unit.test.ts",
    "topic-selection:v1a-harness-negative-e2e": "node --env-file=.env.local .ai/scripts/topic-selection-v1a-harness-negative-e2e.mjs",
    "topic-selection:workflow-scenario": "node --env-file=.env.local .ai/scripts/topic-selection-workflow-scenario-runner.mjs",
    "topic-selection:workflow-matrix-consistency": "node .ai/scripts/topic-selection-workflow-matrix-consistency.mjs",
    "topic-selection:real-e2e:quality-gate": "node --env-file=.env.local .ai/scripts/topic-selection-workflow-scenario-runner.mjs --scenario topic-selection.real-e2e.scale-quality.v1",
    "typecheck": "pnpm --filter @paper-engineering-assistant/shared typecheck && pnpm --filter @paper-engineering-assistant/backend typecheck && pnpm --filter @paper-engineering-assistant/desktop typecheck"
  },
  "devDependencies": {
    "prisma": "5.22.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.2",
      "lodash": "4.18.1"
    }
  }
}
