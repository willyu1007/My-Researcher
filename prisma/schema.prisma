  @@unique([runId, runCellId, workflowBusinessKey], map: "ef_execution_attempt_workflow_business_unique")
  @@unique([id, providerPayloadHash], map: "ef_execution_attempt_exact_payload_unique")
  @@unique([id, providerPayloadId, providerPayloadHash, externalJobRefHash], map: "ef_execution_attempt_collection_binding_unique")
  @@index([runId, attemptSequence], map: "ef_execution_attempt_run_sequence_idx")
  // PB14/D-18 intentionally scans every active real Attempt in the Cycle,
  // including superseded/non-head Runs; therefore this index has no Run/head key.
  @@index([externalPiValidationCycleId, executionMode, lifecycleState], map: "ef_execution_attempt_cycle_mode_state_idx")
  @@index([headAcknowledgementInboxId], map: "ef_execution_attempt_head_ack_idx")
}

model ExperimentFoundationExecutionAttemptEventV2 {
  id                  String   @id
  executionAttemptId  String
  eventSequence       Int
  eventType           String
  priorState          String?
  nextState           String
  providerCommandId   String?  @unique(map: "ef_execution_attempt_event_command_unique")
  providerPayloadHash String
  externalJobRefJson  Json?
  externalJobRefHash  String?
  eventSchemaVersion  String
  eventSnapshotJson   Json     @default("{}")
  eventHash           String
  occurredAt          DateTime @db.Timestamptz(6)

  executionAttempt ExperimentFoundationExecutionAttemptV2 @relation(fields: [executionAttemptId, providerPayloadHash], references: [id, providerPayloadHash], onDelete: Restrict, onUpdate: Restrict, map: "ef_attempt_event_attempt_fkey")
  providerCommand  ExperimentFoundationProviderCommandV2? @relation(fields: [providerCommandId, executionAttemptId], references: [id, executionAttemptId], onDelete: Restrict, onUpdate: Restrict, map: "ef_attempt_event_command_fkey")

  @@unique([executionAttemptId, eventSequence], map: "ef_execution_attempt_event_sequence_unique")
  @@unique([executionAttemptId, eventHash], map: "ef_execution_attempt_event_hash_unique")
  // Required by Prisma's exact composite 1:1 command relation; providerCommandId
  // remains independently unique at the database boundary.
  @@unique([providerCommandId, executionAttemptId], map: "ef_execution_attempt_event_exact_command_unique")
  @@index([executionAttemptId, occurredAt], map: "ef_execution_attempt_event_time_idx")
}

model ExperimentFoundationProviderCommandV2 {
  id                     String    @id
  executionAttemptId     String
  collectionAttemptId    String?
  commandSequence        Int
  operation              String
  commandSchemaVersion   String
  commandSnapshotJson    Json      @default("{}")
  commandHash            String
  responseHash           String?
  providerIdempotencyKey String    @unique(map: "ef_provider_command_idempotency_unique")
  providerPayloadHash    String
  externalJobRefJson     Json?
  externalJobRefHash     String?
  commandState           String
  leaseVersion           Int       @default(0)
  leaseOwner             String?
  leaseExpiresAt         DateTime? @db.Timestamptz(6)
  heartbeatAt            DateTime? @db.Timestamptz(6)
  attemptCount           Int       @default(0)
  nextAttemptAt          DateTime? @db.Timestamptz(6)
  lastErrorCode          String?
  createdAt              DateTime  @db.Timestamptz(6)
  updatedAt              DateTime  @db.Timestamptz(6)
  terminalAt             DateTime? @db.Timestamptz(6)

  executionAttempt  ExperimentFoundationExecutionAttemptV2       @relation(fields: [executionAttemptId, providerPayloadHash], references: [id, providerPayloadHash], onDelete: Restrict, onUpdate: Restrict, map: "ef_provider_command_attempt_fkey")
  collectionAttempt ExperimentFoundationCollectionAttemptV2?     @relation(fields: [collectionAttemptId, executionAttemptId], references: [id, executionAttemptId], onDelete: Restrict, onUpdate: Restrict, map: "ef_provider_command_collection_fkey")
  outcomeEvent      ExperimentFoundationExecutionAttemptEventV2?

  @@unique([executionAttemptId, commandSequence], map: "ef_provider_command_attempt_sequence_unique")
  @@unique([executionAttemptId, commandHash], map: "ef_provider_command_attempt_hash_unique")
  @@unique([id, executionAttemptId], map: "ef_provider_command_exact_attempt_unique")
  @@index([commandState, nextAttemptAt, createdAt], map: "ef_provider_command_ready_idx")
  @@index([leaseExpiresAt], map: "ef_provider_command_lease_expiry_idx")
  @@index([collectionAttemptId], map: "ef_provider_command_collection_idx")
}

model ExperimentFoundationCollectionAttemptV2 {
  id                     String    @id
  executionAttemptId     String    @unique(map: "ef_collection_attempt_execution_unique")
  businessIdempotencyKey String
  collectionRequestHash  String
  providerPayloadId      String
  providerPayloadHash    String
  externalJobRefJson     Json
  externalJobRefHash     String
  collectionState        String
  stateVersion           Int       @default(0)
  preparedAt             DateTime  @db.Timestamptz(6)
  updatedAt              DateTime  @db.Timestamptz(6)
  collectedAt            DateTime? @db.Timestamptz(6)

  executionAttempt   ExperimentFoundationExecutionAttemptV2    @relation(fields: [executionAttemptId, providerPayloadId, providerPayloadHash, externalJobRefHash], references: [id, providerPayloadId, providerPayloadHash, externalJobRefHash], onDelete: Restrict, onUpdate: Restrict, map: "ef_collection_attempt_attempt_fkey")
  providerPayload    ExperimentFoundationProviderPayloadV2     @relation(fields: [providerPayloadId, providerPayloadHash], references: [id, payloadHash], onDelete: Restrict, onUpdate: Restrict, map: "ef_collection_attempt_payload_fkey")
  commands           ExperimentFoundationProviderCommandV2[]
  provisionalOutputs ExperimentFoundationProvisionalOutputV2[]

  // Required by Prisma's exact composite 1:1 Attempt relation; the shorter
  // executionAttemptId unique remains the authoritative one-Collection limit.
  @@unique([executionAttemptId, providerPayloadId, providerPayloadHash, externalJobRefHash], map: "ef_collection_attempt_exact_binding_unique")
  @@unique([id, executionAttemptId], map: "ef_collection_attempt_exact_attempt_unique")
}

model ExperimentFoundationProvisionalOutputV2 {
  id                    String   @id
  collectionAttemptId   String
  ordinal               Int
  outputKind            String
  outputClass           String
  manifestSchemaVersion String
  redactedManifestJson  Json     @default("{}")
  outputHash            String
  createdAt             DateTime @db.Timestamptz(6)

  collectionAttempt ExperimentFoundationCollectionAttemptV2 @relation(fields: [collectionAttemptId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "ef_provisional_output_collection_fkey")

  @@unique([collectionAttemptId, ordinal], map: "ef_provisional_output_collection_ordinal_unique")
  @@unique([collectionAttemptId, outputKind], map: "ef_provisional_output_collection_kind_unique")
  @@unique([collectionAttemptId, outputHash], map: "ef_provisional_output_collection_hash_unique")
}
