  @@unique([id, currentRevisionId, currentRevisionSequence], map: "pi_ewo_branch_current_exact_unique")
  @@unique([id, headRevisionId, headRevisionSequence], map: "pi_ewo_branch_head_exact_unique")
  @@index([implementationProjectId, validationCycleId], map: "pi_ewo_branch_project_cycle_idx")
  @@index([currentRevisionSequence], map: "pi_ewo_branch_current_sequence_idx")
  @@index([headRevisionSequence], map: "pi_ewo_branch_head_sequence_idx")
}

