{
  "name": "@paper-engineering-assistant/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/app.ts",
  "types": "src/app.ts",
  "scripts": {
    "pretypecheck": "pnpm run prisma:generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:experiment-foundation-scripts": "pnpm run prisma:generate && tsc -p tsconfig.experiment-foundation-scripts.json --noEmit",
    "test": "node scripts/run-node-tests.mjs",
    "test:repeat": "node scripts/run-node-tests-repeat.mjs",
    "prisma:format": "prisma format --schema ../../prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema ../../prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "experiment-foundation:scifact-authority:apply": "node --env-file=../../.env.local --loader ts-node/esm scripts/apply-experiment-foundation-scifact-authority.ts",
    "experiment-foundation:scifact-authority:plan": "node --loader ts-node/esm scripts/plan-experiment-foundation-scifact-authority.ts",
    "experiment-foundation:scifact-bundle:apply": "node --env-file=../../.env.local --loader ts-node/esm scripts/apply-experiment-foundation-scifact-execution-bundle.ts",
    "experiment-foundation:scifact-bundle:plan": "node --loader ts-node/esm scripts/plan-experiment-foundation-scifact-execution-bundle.ts",
    "experiment-foundation:m7-l1:live": "node --env-file=../../.env.local --loader ts-node/esm scripts/run-experiment-foundation-m7-l1-live-window.ts",
    "scientific-evidence:p5:stage-one": "node --env-file=../../.env.local --loader ts-node/esm scripts/apply-scientific-evidence-p5-stage-one.ts",
    "scientific-evidence:p5:prepare-package": "node --env-file=../../.env.local --loader ts-node/esm scripts/prepare-scientific-evidence-p5-execution-package.ts",
    "scientific-evidence:p5:prepare-result-analysis-recovery": "node --env-file=../../.env.local --loader ts-node/esm scripts/prepare-scientific-evidence-p5-result-analysis-recovery-package.ts",
    "scientific-evidence:p5:run-result-analysis-recovery": "node --env-file=../../.env.local --loader ts-node/esm scripts/run-scientific-evidence-p5-result-analysis-recovery.ts",
    "scientific-evidence:p5:prepare-closure-packet-continuation": "node --env-file=../../.env.local --loader ts-node/esm scripts/prepare-scientific-evidence-p5-closure-packet-continuation-package.ts",
    "scientific-evidence:p5:run-closure-packet-continuation": "node --env-file=../../.env.local --loader ts-node/esm scripts/run-scientific-evidence-p5-closure-packet-continuation.ts",
    "scientific-evidence:p5:prepare-packet-trace-result-analysis-successor": "node --env-file=../../.env.local --loader ts-node/esm scripts/prepare-scientific-evidence-p5-packet-trace-result-analysis-successor-package.ts",
    "scientific-evidence:p5:run-packet-trace-result-analysis-successor": "node --env-file=../../.env.local --loader ts-node/esm scripts/run-scientific-evidence-p5-packet-trace-result-analysis-successor.ts",
    "scientific-evidence:p5:prepare-packet-only-recovery": "node --env-file=../../.env.local --loader ts-node/esm scripts/prepare-scientific-evidence-p5-packet-only-recovery-package.ts",
    "scientific-evidence:p5:run-packet-only-recovery": "node --env-file=../../.env.local --loader ts-node/esm scripts/run-scientific-evidence-p5-packet-only-recovery.ts",
    "scientific-evidence:p5:prepare-claim-dossier-final-acceptance": "OPENAI_API_KEY= node --env-file=../../.env.local --loader ts-node/esm scripts/prepare-scientific-evidence-p5-claim-dossier-final-acceptance-package.ts",
    "scientific-evidence:p5:run-claim-dossier-final-acceptance": "OPENAI_API_KEY= node --env-file=../../.env.local --loader ts-node/esm scripts/run-scientific-evidence-p5-claim-dossier-final-acceptance.ts",
    "scientific-evidence:p5:credential-integrity": "node --loader ts-node/esm scripts/issue-scientific-evidence-p5-credential-integrity-receipt.ts",
    "scientific-evidence:p5:qualify-credential": "node --loader ts-node/esm scripts/qualify-scientific-evidence-p5-credential.ts",
    "scientific-evidence:p5:live": "node --env-file=../../.env.local --loader ts-node/esm scripts/run-scientific-evidence-p5-live-window.ts",
    "scientific-evidence:p5:close": "node --env-file=../../.env.local --loader ts-node/esm scripts/close-scientific-evidence-p5-window.ts",
    "dev": "node --enable-source-maps --loader ts-node/esm src/server.ts",
    "dev:prisma": "node --env-file=../../.env.local --enable-source-maps --loader ts-node/esm src/server.ts",
    "content-processing:backfill": "node scripts/backfill-literature-content-processing.mjs",
    "experiment-foundation:d19-fixture:import": "node --env-file=../../.env.local --loader ts-node/esm scripts/import-experiment-foundation-d19-typed-fixture.ts",
    "v1b:backfill-n4-handoff-hash": "node --env-file=../../.env.local --loader ts-node/esm scripts/backfill-v1b-n4-handoff-hash.ts",
    "v1b:n8-calibration-dry-run": "node --loader ts-node/esm scripts/run-n8-calibration-dry-run.ts"
  },
  "dependencies": {
    "@alicloud/aiworkspace20210204": "6.2.0",
    "@alicloud/openapi-core": "1.0.8",
    "@alicloud/pai-dlc20201203": "1.10.0",
    "@paper-engineering-assistant/shared": "workspace:*",
    "@prisma/client": "^5.22.0",
    "ajv": "^8.18.0",
    "ali-oss": "^6.23.0",
    "fast-xml-parser": "^5.7.3",
    "fastify": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2"
  }
}
