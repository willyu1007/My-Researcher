#!/bin/sh
# Keep task bundles and project-hub projections converged before governance commits.

set -e

if git diff --cached --name-only | grep -qE '^(dev-docs/|\.ai/project/)'; then
  echo "[hook] Governance files changed; synchronizing project hub..."
  node .ai/scripts/ctl-project-governance.mjs sync --apply
  git add .ai/project dev-docs
  node .ai/scripts/ctl-project-governance.mjs lint --strict
fi

exit 0
