// T-132 Pack A: additive PI v2 WorkOrder authority. These models deliberately
// keep every EF-owned Run reference external and define no PI <-> EF relation.
model PaperImplementationExperimentWorkOrderBranchV2 {
  id                       String   @id
  implementationProjectId  String
  validationCycleId        String
  branchKey                String
  branchFrameSchemaVersion String
  branchFrameJson          Json     @default("{}")
  branchFrameHash          String
  stateVersion             Int      @default(0)
  currentRevisionId        String?  @unique(map: "pi_ewo_branch_current_revision_unique")
  currentRevisionSequence  Int?
  headVersion              Int      @default(0)
  headRevisionId           String?  @unique(map: "pi_ewo_branch_head_revision_unique")
  headRevisionSequence     Int?
  headRunId                String?
  headRunManifestHash      String?
  headEventId              String?
  createdAt                DateTime @db.Timestamptz(6)
  updatedAt                DateTime @db.Timestamptz(6)

  revisions       PaperImplementationExperimentWorkOrderRevisionV2[]  @relation("PIExperimentWorkOrderBranchRevisionsV2")
  currentRevision PaperImplementationExperimentWorkOrderRevisionV2?   @relation("PIExperimentWorkOrderCurrentRevisionV2", fields: [id, currentRevisionId, currentRevisionSequence], references: [branchId, id, revisionSequence], onDelete: Restrict, onUpdate: Restrict, map: "pi_ewo_branch_current_exact_fkey")
