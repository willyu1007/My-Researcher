DASHSCOPE_API_KEY_CODING=<secret:dashscope_api_key_coding>

# DASHSCOPE_BASE_URL: OpenAI-compatible DashScope base URL used by backend LLM workflows; may be overridden in .env.local for local provider experiments.; type=url; optional; default='https://dashscope.aliyuncs.com/compatible-mode/v1'
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

