{
  "Version": "1",
  "Statement": [
    {
      "Sid": "M7L1RuntimeListInput",
      "Effect": "Allow",
      "Action": ["oss:ListObjects"],
      "Resource": "acs:oss:*:*:pea-m7-canary-6194-202607",
      "Condition": {
        "StringLike": {
          "oss:Prefix": ["input", "input/*"]
        }
      }
    },
    {
      "Sid": "M7L1RuntimeReadInputObjects",
      "Effect": "Allow",
      "Action": ["oss:GetObject"],
      "Resource": "acs:oss:*:*:pea-m7-canary-6194-202607/input/*"
    },
    {
      "Sid": "M7L1RuntimeWriteOutputOnly",
      "Effect": "Allow",
      "Action": ["oss:PutObject"],
      "Resource": "acs:oss:*:*:pea-m7-canary-6194-202607/output/*"
    },
    {
      "Sid": "M7L1RuntimeDenyControlPlane",
      "Effect": "Deny",
      "Action": ["paidlc:*", "oss:DeleteObject"],
      "Resource": "*"
    }
  ]
}
