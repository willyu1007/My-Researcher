#!/bin/sh
# Link a task branch to its existing task bundle. Explicit trailers are never changed.

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

case "$COMMIT_SOURCE" in
  merge|squash) exit 0 ;;
esac

if [ "$SKIP_TASK_TRAILER" = "1" ] ||
  ! command -v node >/dev/null 2>&1 ||
  [ ! -f .ai/scripts/ctl-project-governance.mjs ]; then
  exit 0
fi

if git interpret-trailers --parse <"$COMMIT_MSG_FILE" | grep -qE '^Task:[[:space:]]*[^[:space:]]'; then
  exit 0
fi

BRANCH=$(git branch --show-current 2>/dev/null)
TASK_IDS=$(printf '%s\n' "$BRANCH" | grep -oE 'T-[0-9]{3}' | sort -u)
TASK_COUNT=$(printf '%s\n' "$TASK_IDS" | grep -c .)

if [ "$TASK_COUNT" -ne 1 ]; then
  exit 0
fi

TASK_ID=$TASK_IDS
if ! node .ai/scripts/ctl-project-governance.mjs query --id "$TASK_ID" |
  grep -q "\"id\":\"$TASK_ID\""; then
  exit 0
fi

git interpret-trailers --if-exists doNothing --in-place --trailer "Task: $TASK_ID" "$COMMIT_MSG_FILE"
echo "[hook] Linked commit to Task: $TASK_ID"
exit 0
