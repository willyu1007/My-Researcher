.cursor/
.copilot/
.gemini/

# Provider skill wrappers
# NOTE: `.claude/skills/` and `.codex/skills/` are generated by `node .ai/scripts/sync-skills.mjs`
# but SHOULD be committed to enable "clone and use" across teams.
# DO NOT ignore `.claude/` or `.codex/`.

# Generated entry files
CLAUDE.md
.cursorrules

# Temporary files
.ai/.tmp/
.env.local
.env.*.local
env/.secrets-store/
env/values/*.local.yaml
env/values/*.local.yml

# Node
node_modules/
*.tsbuildinfo
/apps/desktop/dist/

# Python
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Volatile verification artifacts
dev-docs/**/artifacts/**/*.log
dev-docs/**/artifacts/**/00-context.json
dev-docs/**/artifacts/**/00-context.txt
dev-docs/**/artifacts/**/90-summary.json

# CI script outputs (uploaded via actions/upload-artifact, never committed;
# some embed database URLs — durable artifacts live under dev-docs/**/artifacts/)
/artifacts/
